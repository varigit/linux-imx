/ {
	carrier_tpm_reset: carrier-tpm-reset {
		compatible = "gpio-reset";
		#reset-cells = <0>;
		reset-gpios = <&pca9534 0 GPIO_ACTIVE_LOW>;
		initially-in-reset;
	};
};

&i2c2 {
	/* GPIO Expander 3 */
	pca9534: gpio@22 {
		compatible = "nxp,pca9534";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;

		/*
		 * RGB_SEL
		 * output-lo: Configure mux for DARTs LVDS
		 * output-hi: Configure mux for DART-MX91 RGB2LVDS
		 */
		rgb_sel {
			gpio-hog;
			gpios = <7 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "rgb_sel";
		};
	};
};

&i2c4 {
	/* TPM */
	st33ktpm2xi2c: st33ktpm2xi2c@2e {
		compatible = "st,st33ktpm2xi2c", "tcg,tpm-tis-i2c";
		reg = <0x2e>;
		label = "tpm";
		resets = <&carrier_tpm_reset>;
	};
};
