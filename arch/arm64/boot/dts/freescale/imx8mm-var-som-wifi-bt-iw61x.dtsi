/ {
	reg_wifi_1v8: regulator-wifi-1v8 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wifi_pwr_1v8>;
		regulator-name = "WIFI_PWR_1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpio2 20 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_wifi_3v3: regulator-wifi-3v3 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wifi_pwr_3v3>;
		regulator-name = "WIFI_PWR_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio2 7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wifi_en>;
		reset-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
	};
};

&uart2 {
	pinctrl-0 = <&pinctrl_uart2>;

	bluetooth_iw61x: bluetooth_iw61x {
		compatible = "nxp,88w8987-bt";
		/* Mux BT_EN to GPIO here: gpio-hog nodes do not apply pinctrl */
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_bt_en>;
		status = "okay";
	};
};

/* WIFI */
&usdhc1 {
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>;
	vqmmc-supply = <&reg_wifi_1v8>;
	vmmc-supply = <&reg_wifi_3v3>;
	mmc-pwrseq = <&wifi_pwrseq>;
};

&iomuxc {
	pinctrl_bt_en: btengrp {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_DATA4_GPIO2_IO6		0xc1	/* BT_REG_ON       */
		>;
	};

	pinctrl_wifi_en: wifiengrp {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_RESET_B_GPIO2_IO10		0xc1	/* WIFI_REG_ON  */
		>;
	};

	pinctrl_wifi_pwr_1v8: wifipwr1v8grp {
		fsl,pins = <
			MX8MM_IOMUXC_SD2_WP_GPIO2_IO20		0x140	/* WIFI_1V8_PWR_EN */
		>;
	};

	pinctrl_wifi_pwr_3v3: wifipwr3v3grp {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_DATA5_GPIO2_IO7		0xc1	/* WIFI_3V3_PWR_EN */
		>;
	};
};

&gpio2 {
	bt_en_hog: bt-en-hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "bt_en";
	};
};
