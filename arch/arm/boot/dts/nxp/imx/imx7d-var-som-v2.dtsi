/ {
	iw61x_pwrseq: iw61x-pwrseq {
		compatible = "mmc-pwrseq-simple";
		post-power-on-delay-ms = <100>;
		power-off-delay-us = <10000>;
		reset-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&fec1 {
	phy-mode = "rgmii";
};

&fec2 {
	phy-mode = "rgmii";
};

&pinctrl_wlan {
	fsl,pins = <
		MX7D_PAD_LPSR_GPIO1_IO04__GPIO1_IO4	0x09 /* WLAN_EN */
	>;
};

&pinctrl_wlan_sleep {
	fsl,pins = <
		MX7D_PAD_LPSR_GPIO1_IO04__GPIO1_IO4	0x10 /* WLAN_EN */
	>;
};

/* BT */
&uart3 {
	bluetooth_iw61x: bluetooth_iw61x {
		compatible = "nxp,88w8987-bt";
		status = "okay";
	};
};

/* WiFi */
&usdhc2 {
	mmc-pwrseq = <&iw61x_pwrseq>;

	/delete-node/ bcrmf@1;
};
