 *
 * Settings for SymphonyBoard
 */

/ {
	backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm2 0 50000>;
		brightness-levels = <0 4 8 16 32 64 128 248>;
		default-brightness-level = <7>;
		status = "okay";
	};

	/* Buttons in the motherboard */
	gpio-keys {
		compatible = "gpio-keys";

		back {
			label = "Back";
			gpios = <&pca9534 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_BACK>;
		};

		home {
			label = "Home";
			gpios = <&pca9534 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOME>;
		};

		menu {
			label = "Menu";
			gpios = <&pca9534 3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_MENU>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";
		status = "okay";

		heartbeat {
			label = "heartbeat";
			gpios = <&pca9534 0 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};
	};

	xtal24mhz: xtal24mhz@24M {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
	};
};

&can1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	status = "okay";
};

&i2c1 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
	status = "okay";

	/* GPIO expander */
	pca9534:gpio@20 {
		compatible = "nxp,pca9534";
		reg = <0x20>;
		gpio-controller;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pca9534>;
		interrupt-parent = <&gpio1>;
		interrupts = <3 IRQ_TYPE_EDGE_FALLING>;
		#gpio-cells = <2>;
		wakeup-source;
	};

	ov564x_mipi: ov564x_mipi@3c {
		compatible = "ovti,ov564x_mipi";
		reg = <0x3c>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ov564x_mipi>;
		clocks = <&xtal24mhz>;
		clock-names = "csi_mclk";
		rst-gpios = <&gpio3 5 GPIO_ACTIVE_LOW>;
		csi_id = <1>;
		mclk = <24000000>;
		mclk_source = <0>;
	};
};

&i2c2 {
	hdmi_edid: edid@50 {
		compatible = "fsl,imx6-hdmi-i2c";
		reg = <0x50>;
	};
};

&i2c3 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c3>;
	status = "okay";

	/* GPIO Expander */
	pcal6408: gpio@21 {
		compatible = "nxp,pcal6408";
		reg = <0x21>;
		standard-regs-fallback;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";

		/*
		* RGB_SEL
		* output-lo: Configure mux for VAR-SOMs LVDS
		* output-hi: Configure mux for VAR-SOM-MX91 RGB2LVDS
		*/
		rgb_sel {
			gpio-hog;
			gpios = <7 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "rgb_sel";
		};

		/*
		* The SEC_RSTN line for the TPM2 module has an external
		* pull-down, keeping the module in reset by default.
		* Drive this signal high to release the TPM2 from reset.
		*/
		sec_resetn {
			gpio-hog;
			gpios = <4 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "sec_rstn";
		};
	};

	/* TPM */
	st33ktpm2xi2c: st33ktpm2xi2c@2e {
		compatible = "infineon,slb9673", "tcg,tpm-tis-i2c";
		reg = <0x2e>;
		/*
		* reset-gpios is not used by the TPM driver, but forces
		* probe ordering: ensures GPIO expander is initialized
		* and sec_rstn GPIO hog has released TPM from reset
		* before the TPM driver probes.
		*/
		reset-gpios = <&pcal6408 4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	/* Touch */
	cap_touch: ft5x06_ts@38 {
		compatible = "edt,edt-ft5x06";
		reg = <0x38>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ft5x06>;
		interrupt-parent = <&gpio1>;
		interrupts = <9 0>;
		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;
		touchscreen-inverted-x;
		touchscreen-inverted-y;
		wakeup-source;
		status = "okay";
	};

	/* DS1337 RTC module */
	rtc@68 {
		compatible = "dallas,ds1337";
		reg = <0x68>;
	};
};

&iomuxc {
	imx6qdl-var-som-mx6 {
		pinctrl_flexcan1: flexcan1grp {
			fsl,pins = <
				MX6QDL_PAD_GPIO_7__FLEXCAN1_TX		0x80000000
				MX6QDL_PAD_GPIO_8__FLEXCAN1_RX		0x80000000
			>;
		};

		pinctrl_ft5x06: ft5x06grp {
			fsl,pins = <
				MX6QDL_PAD_GPIO_9__GPIO1_IO09		0x80000000
			>;
		};

		pinctrl_i2c1: i2c1grp {
			fsl,pins = <
				MX6QDL_PAD_CSI0_DAT8__I2C1_SDA		0x4001b8b1
				MX6QDL_PAD_CSI0_DAT9__I2C1_SCL		0x4001b8b1
			>;
		};

		pinctrl_i2c3: i2c3grp {
			fsl,pins = <
				MX6QDL_PAD_GPIO_5__I2C3_SCL		0x4001b8b1
				MX6QDL_PAD_GPIO_16__I2C3_SDA		0x4001b8b1
			>;
		};
		pinctrl_ov564x_mipi: ov564xmipigrp {
			fsl,pins = <
				/* J1.86-MIPI_CAM_BUF_CTL: pull up present
				 * pull dowm to manage additional signals
				 * like trigger, powerdown, opt, sync
				 */
				MX6QDL_PAD_EIM_D19__GPIO3_IO19		0x80000000
				/* Camera reset */
				MX6QDL_PAD_EIM_DA5__GPIO3_IO05		0x80000000
			>;
		};
		pinctrl_pca9534: pca9534grp {
			fsl,pins = <
				MX6QDL_PAD_GPIO_3__GPIO1_IO03		0x80000000
			>;
		};

		pinctrl_pwm2: pwm2grp {
			fsl,pins = <
				MX6QDL_PAD_DISP0_DAT9__PWM2_OUT		0x1b0b1
			>;
		};

		/* Variscite Uart3 support */
		pinctrl_uart3: uart3grp {	/* RX/TX RTS/CTS */
			fsl,pins = <
				MX6QDL_PAD_EIM_D25__UART3_RX_DATA	0x1b0b1
				MX6QDL_PAD_EIM_D24__UART3_TX_DATA	0x1b0b1
				MX6QDL_PAD_EIM_D23__UART3_CTS_B		0x1b0b1
				MX6QDL_PAD_EIM_EB3__UART3_RTS_B		0x1b0b1
			>;
		};

		pinctrl_usdhc2_gpio: usdhc2gpiogrp {
			fsl,pins = <
				/* SDMMC2 CD */
				MX6QDL_PAD_KEY_COL4__GPIO4_IO14		0x80000000
			>;
		};
	};
};

&ldb {
	status = "okay";

	lvds-channel@0 {
		fsl,data-mapping = "spwg";
		fsl,data-width = <18>;
		primary;
		status = "okay";

		display-timings {
			native-mode = <&timing0>;
			timing0: hsd100pxn1 {
				clock-frequency = <32000000>;
				hactive = <800>;
				vactive = <480>;
				hback-porch = <39>;
				hfront-porch = <39>;
				vback-porch = <29>;
				vfront-porch = <13>;
				hsync-len = <47>;
				vsync-len = <2>;
			};
		};
	};

	lvds-channel@1 {
		fsl,data-mapping = "spwg";
		fsl,data-width = <18>;
		status = "okay";

		display-timings {
			native-mode = <&timing1>;
			timing1: hsd100pxn1 {
				clock-frequency = <32000000>;
				hactive = <800>;
				vactive = <480>;
				hback-porch = <39>;
				hfront-porch = <39>;
				vback-porch = <29>;
				vfront-porch = <13>;
				hsync-len = <47>;
				vsync-len = <2>;
			};
		};
	};
};

&mxcfb1 {
	interface_pix_fmt = "RGB666";
};

&pcie {
	reset-gpio = <&pcal6408 1 GPIO_ACTIVE_LOW>;
	/* Symphony board has been designed for iMX8 families SoMs and
	 * provides an external clock source (U6).
	 * To use iMX6 SoMs, there are 2 possible choices:
	 * 1) use internal SoC clock: install R21 (to disable ext clock)
	 *    install 100nF instead of R37,R38, remove R22,R23,R35,R36
	 * 2) use external clock: PLL6 bypass mode is mandatory required when
	 *    external oscillator is used as pcie ref clk.
	 *    Also, disable fec/sata, because they can't provide internal
	 *    reference clocks when pll6 is in bypass mode.
	 *    NXP REF: MLK-13186
	 */
	status = "disabled";
};

&pwm2 {
	#pwm-cells = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm2>;
	status = "okay";
};

/* ttymxc2 UART */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	uart-has-rtscts;
	status = "okay";
};

&usdhc2 {	/* uSDHC2, MMC/SD card */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	cd-gpios = <&gpio4 14 GPIO_ACTIVE_LOW>;
	no-1-8-v;
	keep-power-in-suspend;
	enable-sdio-wakeup;
	status = "okay";
};
